<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LuminaNt8AddOn</RootNamespace>
    <!-- Unique name so NT never binds a stale LuminaNt8AddOn 1.0 without FabricNtHost. -->
    <AssemblyName>Lumina.Fabric.NtBridge</AssemblyName>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumina.Execution.Fabric\Lumina.Execution.Fabric.csproj" />
  </ItemGroup>

  <!-- Optional NT8 API reference — set NINJATRADER8_BIN to build against real NinjaTrader.Core. -->
  <ItemGroup Condition="'$(NINJATRADER8_BIN)' != '' And Exists('$(NINJATRADER8_BIN)\NinjaTrader.Core.dll')">
    <Reference Include="NinjaTrader.Core">
      <HintPath>$(NINJATRADER8_BIN)\NinjaTrader.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
  </ItemGroup>

  <PropertyGroup Condition="'$(NINJATRADER8_BIN)' == '' Or !Exists('$(NINJATRADER8_BIN)\NinjaTrader.Core.dll')">
    <DefineConstants>$(DefineConstants);FABRIC_STANDALONE</DefineConstants>
  </PropertyGroup>
</Project>
