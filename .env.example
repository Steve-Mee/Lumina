# xAI API key for hybrid NewsAgent integration
XAI_API_KEY=sk-...
# Lumina Launcher Environment Configuration
# Kopieer dit bestand naar .env en pas aan waar nodig

# Backend URL (FastAPI server in lumina_os)
LUMINA_BACKEND_URL=http://localhost:8000

# Optioneel: Specifieke Python executable
# LUMINA_PYTHON=python

# Logging niveau (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
