{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumina.local/schemas/ninjatrader/v1/submit_order.json",
  "title": "NinjaTraderSubmitOrderFrame",
  "allOf": [{ "$ref": "base_frame.json" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "correlation_id", "ts", "client_order_id", "symbol", "side", "quantity", "order_type"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "type": { "type": "string", "const": "submit_order" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string" },
    "client_order_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "enum": ["BUY", "SELL"] },
    "quantity": { "type": "integer", "minimum": 1 },
    "order_type": { "type": "string", "enum": ["MARKET", "LIMIT", "STOP"] },
    "stop_loss": { "type": "number" },
    "take_profit": { "type": "number" },
    "mode_context": { "type": "string", "enum": ["paper", "sim", "sim_real_guard", "real"] }
  }
}
