{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumina.local/schemas/ninjatrader/v1/auth.json",
  "title": "NinjaTraderAuthFrame",
  "allOf": [{ "$ref": "base_frame.json" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "correlation_id", "ts", "token", "client"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "type": { "type": "string", "const": "auth" },
    "correlation_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string" },
    "token": { "type": "string", "minLength": 1 },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "ninjatrader_version": { "type": "string" }
      }
    }
  }
}
