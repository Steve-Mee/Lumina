# Kopieer naar `.env.local` en vul in (zie README). `.env.local` wordt niet gecommit.

# Operatornaam in de dashboard top-bar (`MonitoringDashboard.tsx`)
VITE_DASHBOARD_OPERATOR=Steve

# Optioneel alleen voor lokaal ontwikkelen: wordt bij eerste load (dev) naar
# localStorage `lumina_api_key` geschreven als die nog leeg is.
# NIET gebruiken voor gevoelige productie-keys — VITE_-vars zitten in de client bundle.
# VITE_LUMINA_API_KEY=

# Als je `npm run dev` in Docker draait en de FastAPI-backend op je host luistert op :8000:
# VITE_API_PROXY_TARGET=http://host.docker.internal:8000
